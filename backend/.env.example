# --- Database -------------------------------------------------------------
# Server mode (docker run -p 6379:6379 falkordb/falkordb). Leave unset to use embedded falkordblite.
# FALKORDB_URL=redis://localhost:6379

# --- LLM (optional: without a key the agents run in scripted mode) ---------
# anthropic | openai | none   (auto: anthropic if ANTHROPIC_API_KEY set, else openai if OPENAI_API_KEY set, else none)
LLM_PROVIDER=none
# Override the default model (anthropic: claude-sonnet-4-5, openai: gpt-4.1)
# LLM_MODEL=claude-sonnet-4-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Demo pacing ------------------------------------------------------------
# Seconds between streamed agent events (0 = as fast as possible)
SHELLGAME_PACE=0.4
